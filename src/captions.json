[
  {
    "source": 1,
    "start": 1.32,
    "end": 1.9,
    "text": "Koľkokrát sa vám"
  },
  {
    "source": 1,
    "start": 1.9,
    "end": 2.29,
    "text": "už stalo,"
  },
  {
    "source": 1,
    "start": 2.29,
    "end": 2.76,
    "text": "že vám niekto"
  },
  {
    "source": 1,
    "start": 2.76,
    "end": 3.05,
    "text": "povedal,"
  },
  {
    "source": 1,
    "start": 3.05,
    "end": 3.57,
    "text": "že niečo"
  },
  {
    "source": 1,
    "start": 3.57,
    "end": 4.14,
    "text": "nie je možné?"
  },
  {
    "source": 1,
    "start": 5.06,
    "end": 5.58,
    "text": "Mne sa to"
  },
  {
    "source": 1,
    "start": 5.58,
    "end": 6.4,
    "text": "stáva pomerne často."
  },
  {
    "source": 1,
    "start": 6.4,
    "end": 6.9,
    "text": "A úprimne?"
  },
  {
    "source": 1,
    "start": 6.9,
    "end": 7.98,
    "text": "Milujem ten pocit,"
  },
  {
    "source": 1,
    "start": 8,
    "end": 8.89,
    "text": "keď môžem niekomu"
  },
  {
    "source": 1,
    "start": 8.89,
    "end": 9.45,
    "text": "dokázať,"
  },
  {
    "source": 1,
    "start": 9.45,
    "end": 9.8,
    "text": "že sa mýlil."
  },
  {
    "source": 1,
    "start": 10.82,
    "end": 11.25,
    "text": "Presne takto som"
  },
  {
    "source": 1,
    "start": 11.25,
    "end": 11.84,
    "text": "rozmýšľal, keď sme"
  },
  {
    "source": 1,
    "start": 11.84,
    "end": 12.42,
    "text": "dostali zadanie"
  },
  {
    "source": 1,
    "start": 12.42,
    "end": 13.07,
    "text": "na hackathone"
  },
  {
    "source": 1,
    "start": 13.07,
    "end": 14.28,
    "text": "Slovenskej sporiteľne."
  },
  {
    "source": 1,
    "start": 14.84,
    "end": 15.42,
    "text": "Kde boli vypísané"
  },
  {
    "source": 1,
    "start": 15.42,
    "end": 15.99,
    "text": "štyri výzvy"
  },
  {
    "source": 1,
    "start": 15.99,
    "end": 16.5,
    "text": "a mali sme"
  },
  {
    "source": 1,
    "start": 16.5,
    "end": 17.21,
    "text": "si vybrať jednu,"
  },
  {
    "source": 1,
    "start": 17.21,
    "end": 18.26,
    "text": "ktorú vypracujeme."
  },
  {
    "source": 1,
    "start": 18.94,
    "end": 19.72,
    "text": "Ja som si povedal:"
  },
  {
    "source": 1,
    "start": 19.84,
    "end": 20.49,
    "text": "prečo nevypracovať"
  },
  {
    "source": 1,
    "start": 20.49,
    "end": 21.16,
    "text": "všetky štyri?"
  },
  {
    "source": 1,
    "start": 22.18,
    "end": 22.68,
    "text": "Niekomu by sa"
  },
  {
    "source": 1,
    "start": 22.68,
    "end": 23.51,
    "text": "to zdalo nemožné,"
  },
  {
    "source": 1,
    "start": 23.51,
    "end": 24.26,
    "text": "spraviť v takom"
  },
  {
    "source": 1,
    "start": 24.26,
    "end": 25.89,
    "text": "krátkom časovom rozmedzí"
  },
  {
    "source": 1,
    "start": 25.89,
    "end": 26.62,
    "text": "všetky štyri témy."
  },
  {
    "source": 1,
    "start": 27.04,
    "end": 27.45,
    "text": "No ja som"
  },
  {
    "source": 1,
    "start": 27.45,
    "end": 27.86,
    "text": "dostal nápad."
  },
  {
    "source": 1,
    "start": 29.62,
    "end": 30.36,
    "text": "Starý, neintuitívny"
  },
  {
    "source": 1,
    "start": 30.36,
    "end": 31.2,
    "text": "eGrant systém,"
  },
  {
    "source": 1,
    "start": 31.2,
    "end": 31.84,
    "text": "ktorý sme mali"
  },
  {
    "source": 1,
    "start": 31.84,
    "end": 32.4,
    "text": "prerobiť,"
  },
  {
    "source": 1,
    "start": 33.02,
    "end": 34,
    "text": "vôbec netreba prerábať."
  },
  {
    "source": 1,
    "start": 34.16,
    "end": 34.58,
    "text": "Čo keby sme"
  },
  {
    "source": 1,
    "start": 34.58,
    "end": 35.41,
    "text": "iba naučili AI,"
  },
  {
    "source": 1,
    "start": 35.41,
    "end": 35.92,
    "text": "ako v ňom"
  },
  {
    "source": 1,
    "start": 35.92,
    "end": 36.26,
    "text": "robiť,"
  },
  {
    "source": 1,
    "start": 36.48,
    "end": 37.18,
    "text": "a používateľovi by"
  },
  {
    "source": 1,
    "start": 37.18,
    "end": 37.85,
    "text": "sme poskytli len"
  },
  {
    "source": 1,
    "start": 37.85,
    "end": 38.5,
    "text": "jednoduché,"
  },
  {
    "source": 1,
    "start": 38.74,
    "end": 39.4,
    "text": "moderné rozhranie,"
  },
  {
    "source": 1,
    "start": 39.4,
    "end": 40.54,
    "text": "cez ktoré by zadával"
  },
  {
    "source": 1,
    "start": 40.54,
    "end": 41.04,
    "text": "požiadavky,"
  },
  {
    "source": 1,
    "start": 41.46,
    "end": 42.12,
    "text": "dostával výsledky"
  },
  {
    "source": 1,
    "start": 42.12,
    "end": 42.71,
    "text": "a zároveň v"
  },
  {
    "source": 1,
    "start": 42.71,
    "end": 43.21,
    "text": "reálnom čase"
  },
  {
    "source": 1,
    "start": 43.21,
    "end": 43.75,
    "text": "by videl, čo"
  },
  {
    "source": 1,
    "start": 43.75,
    "end": 44.4,
    "text": "AI robí."
  },
  {
    "source": 2,
    "start": 43.4,
    "end": 44.929,
    "text": "Toto originálne riešenie"
  },
  {
    "source": 2,
    "start": 44.929,
    "end": 45.439,
    "text": "a náš AI"
  },
  {
    "source": 2,
    "start": 45.439,
    "end": 46.14,
    "text": "chatbot nás"
  },
  {
    "source": 2,
    "start": 46.14,
    "end": 46.698,
    "text": "dostali až do"
  },
  {
    "source": 2,
    "start": 46.698,
    "end": 47.471,
    "text": "finále a Slovenská"
  },
  {
    "source": 2,
    "start": 47.471,
    "end": 47.9,
    "text": "sporiteľňa"
  },
  {
    "source": 2,
    "start": 47.9,
    "end": 48.758,
    "text": "má doteraz záujem"
  },
  {
    "source": 2,
    "start": 48.758,
    "end": 50.12,
    "text": "implementovať naše riešenie"
  },
  {
    "source": 2,
    "start": 50.12,
    "end": 51.4,
    "text": "do reálneho systému."
  },
  {
    "source": 2,
    "start": 51.4,
    "end": 52.867,
    "text": "Presne takto rozmýšľam"
  },
  {
    "source": 2,
    "start": 52.867,
    "end": 53.6,
    "text": "aj v práci."
  },
  {
    "source": 2,
    "start": 53.6,
    "end": 54.369,
    "text": "Aktuálne pracujem v"
  },
  {
    "source": 2,
    "start": 54.369,
    "end": 55.017,
    "text": "Allianz, kde som"
  },
  {
    "source": 2,
    "start": 55.017,
    "end": 55.3,
    "text": "vyvinul"
  },
  {
    "source": 2,
    "start": 55.3,
    "end": 56.514,
    "text": "AI automatizáciu mojej"
  },
  {
    "source": 2,
    "start": 56.514,
    "end": 56.9,
    "text": "roboty."
  },
  {
    "source": 2,
    "start": 56.9,
    "end": 57.94,
    "text": "Porovnávam, či daný"
  },
  {
    "source": 2,
    "start": 57.94,
    "end": 58.817,
    "text": "klient je naozaj"
  },
  {
    "source": 2,
    "start": 58.817,
    "end": 59.2,
    "text": "klient,"
  },
  {
    "source": 2,
    "start": 59.2,
    "end": 59.98,
    "text": "za ktorého sa"
  },
  {
    "source": 2,
    "start": 59.98,
    "end": 60.4,
    "text": "vydáva."
  },
  {
    "source": 2,
    "start": 60.4,
    "end": 61.686,
    "text": "Takže v jednoduchosti"
  },
  {
    "source": 2,
    "start": 61.686,
    "end": 62.604,
    "text": "som vymyslel AI"
  },
  {
    "source": 2,
    "start": 62.604,
    "end": 63.4,
    "text": "automatizáciu"
  },
  {
    "source": 2,
    "start": 63.4,
    "end": 65,
    "text": "takého background checku"
  },
  {
    "source": 2,
    "start": 65,
    "end": 66.2,
    "text": "našich klientov na"
  },
  {
    "source": 2,
    "start": 66.2,
    "end": 67.4,
    "text": "projekte Symphony."
  },
  {
    "source": 2,
    "start": 67.4,
    "end": 68.147,
    "text": "Keďže tím musí"
  },
  {
    "source": 2,
    "start": 68.147,
    "end": 69.16,
    "text": "denne vyriešiť viac"
  },
  {
    "source": 2,
    "start": 69.16,
    "end": 69.979,
    "text": "ako tisíc takýchto"
  },
  {
    "source": 2,
    "start": 69.979,
    "end": 71.07,
    "text": "alertov, práve vykonávam"
  },
  {
    "source": 2,
    "start": 71.07,
    "end": 71.9,
    "text": "robotu za štyroch"
  },
  {
    "source": 2,
    "start": 71.9,
    "end": 72.5,
    "text": "a môj šéf"
  },
  {
    "source": 2,
    "start": 72.5,
    "end": 73.9,
    "text": "je nadmieru spokojný."
  },
  {
    "source": 2,
    "start": 73.9,
    "end": 75.104,
    "text": "Ale táto schopnosť"
  },
  {
    "source": 2,
    "start": 75.104,
    "end": 76.576,
    "text": "hľadať príležitosti sa"
  },
  {
    "source": 2,
    "start": 76.576,
    "end": 76.91,
    "text": "u mňa"
  },
  {
    "source": 2,
    "start": 76.91,
    "end": 78.849,
    "text": "nekončí iba programovaním."
  },
  {
    "source": 2,
    "start": 78.849,
    "end": 80.34,
    "text": "Takto som rozmýšľal,"
  },
  {
    "source": 2,
    "start": 80.34,
    "end": 80.746,
    "text": "keď som si"
  },
  {
    "source": 2,
    "start": 80.746,
    "end": 81.64,
    "text": "zakladal svoje vlastné"
  },
  {
    "source": 2,
    "start": 81.64,
    "end": 82.656,
    "text": "hudobné vydavateľstvo CBA"
  },
  {
    "source": 2,
    "start": 82.656,
    "end": 82.9,
    "text": "Music."
  },
  {
    "source": 2,
    "start": 82.9,
    "end": 83.592,
    "text": "Toto je nová"
  },
  {
    "source": 2,
    "start": 83.592,
    "end": 85.61,
    "text": "generácia hudobných vydavateľstiev,"
  },
  {
    "source": 2,
    "start": 85.61,
    "end": 86.837,
    "text": "ktoré sa pýtajú"
  },
  {
    "source": 2,
    "start": 86.837,
    "end": 87.9,
    "text": "jednu otázku:"
  },
  {
    "source": 2,
    "start": 87.9,
    "end": 88.805,
    "text": "Kde je najviac"
  },
  {
    "source": 2,
    "start": 88.805,
    "end": 89.709,
    "text": "ľudí, ktorí sú"
  },
  {
    "source": 2,
    "start": 89.709,
    "end": 90.42,
    "text": "otvorení si"
  },
  {
    "source": 2,
    "start": 90.42,
    "end": 91.687,
    "text": "uložiť a počúvať"
  },
  {
    "source": 2,
    "start": 91.687,
    "end": 92.4,
    "text": "pesničku?"
  },
  {
    "source": 2,
    "start": 92.4,
    "end": 93.211,
    "text": "Sú to práve"
  },
  {
    "source": 2,
    "start": 93.211,
    "end": 94.612,
    "text": "sociálne siete, kde"
  },
  {
    "source": 2,
    "start": 94.612,
    "end": 95.94,
    "text": "naše vydavateľstvo"
  },
  {
    "source": 2,
    "start": 95.94,
    "end": 97.746,
    "text": "organicky, s rozpočtom"
  },
  {
    "source": 2,
    "start": 97.746,
    "end": 98.977,
    "text": "0 eur, dosiahlo"
  },
  {
    "source": 2,
    "start": 98.977,
    "end": 99.47,
    "text": "dosahy"
  },
  {
    "source": 2,
    "start": 99.47,
    "end": 101.481,
    "text": "40 miliónov účtov"
  },
  {
    "source": 2,
    "start": 101.481,
    "end": 102.9,
    "text": "za rok 2025."
  },
  {
    "source": 2,
    "start": 102.9,
    "end": 103.813,
    "text": "CBA Music je"
  },
  {
    "source": 2,
    "start": 103.813,
    "end": 105.411,
    "text": "teraz hlavným zdrojom"
  },
  {
    "source": 2,
    "start": 105.411,
    "end": 106.4,
    "text": "môjho príjmu."
  },
  {
    "source": 2,
    "start": 106.4,
    "end": 107.476,
    "text": "Moja schopnosť vidieť"
  },
  {
    "source": 2,
    "start": 107.476,
    "end": 108.5,
    "text": "príležitosť tam, kde"
  },
  {
    "source": 2,
    "start": 108.5,
    "end": 109.416,
    "text": "ostatní vidia iba"
  },
  {
    "source": 2,
    "start": 109.416,
    "end": 110.331,
    "text": "problém, je podľa"
  },
  {
    "source": 2,
    "start": 110.331,
    "end": 110.87,
    "text": "mňa presne"
  },
  {
    "source": 2,
    "start": 110.87,
    "end": 111.646,
    "text": "niečo, čo váš"
  },
  {
    "source": 2,
    "start": 111.646,
    "end": 112.9,
    "text": "AI startup potrebuje."
  },
  {
    "source": 2,
    "start": 112.9,
    "end": 114.093,
    "text": "Okrem veľmi dobrého"
  },
  {
    "source": 2,
    "start": 114.093,
    "end": 115.85,
    "text": "technického základu niekoľko"
  },
  {
    "source": 2,
    "start": 115.85,
    "end": 117.358,
    "text": "mojich open-source projektov"
  },
  {
    "source": 2,
    "start": 117.358,
    "end": 118.22,
    "text": "dostalo ocenenie"
  },
  {
    "source": 2,
    "start": 118.22,
    "end": 119.531,
    "text": "za kvalitné riešenie"
  },
  {
    "source": 2,
    "start": 119.531,
    "end": 120.318,
    "text": "na GitHube a"
  },
  {
    "source": 2,
    "start": 120.318,
    "end": 121.17,
    "text": "boli zaradené"
  },
  {
    "source": 2,
    "start": 121.17,
    "end": 122.535,
    "text": "do open-source AI"
  },
  {
    "source": 2,
    "start": 122.535,
    "end": 123.9,
    "text": "reference indexu."
  },
  {
    "source": 2,
    "start": 123.9,
    "end": 124.52,
    "text": "Mám aj cit"
  },
  {
    "source": 2,
    "start": 124.52,
    "end": 126.008,
    "text": "pre produktové myslenie,"
  },
  {
    "source": 2,
    "start": 126.008,
    "end": 126.69,
    "text": "realizáciu,"
  },
  {
    "source": 2,
    "start": 126.69,
    "end": 128.676,
    "text": "používanie moderných nástrojov"
  },
  {
    "source": 2,
    "start": 128.676,
    "end": 129.47,
    "text": "a hlavu plnú"
  },
  {
    "source": 2,
    "start": 129.47,
    "end": 130.9,
    "text": "dobrých nápadov."
  },
  {
    "source": 2,
    "start": 130.9,
    "end": 132.644,
    "text": "Takže práve preto"
  },
  {
    "source": 2,
    "start": 132.644,
    "end": 134.592,
    "text": "ma zaujalo Codeless"
  },
  {
    "source": 2,
    "start": 134.592,
    "end": 134.9,
    "text": "AI."
  },
  {
    "source": 2,
    "start": 134.9,
    "end": 136.114,
    "text": "Ďakujem veľmi pekne"
  },
  {
    "source": 2,
    "start": 136.114,
    "end": 136.817,
    "text": "za váš čas."
  },
  {
    "source": 2,
    "start": 136.817,
    "end": 137.648,
    "text": "V prípade, že"
  },
  {
    "source": 2,
    "start": 137.648,
    "end": 137.84,
    "text": "vás"
  },
  {
    "source": 2,
    "start": 137.84,
    "end": 139.165,
    "text": "moje projekty zaujali,"
  },
  {
    "source": 2,
    "start": 139.165,
    "end": 140.43,
    "text": "som otvorený krátkemu"
  },
  {
    "source": 2,
    "start": 140.43,
    "end": 141.9,
    "text": "callu alebo pohovoru."
  }
]
